<Window x:Class="StockManager.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:StockManager.Converters"
        xmlns:vm="clr-namespace:StockManager.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Dashboard"
        Height="600" Width="980"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="#F4F7FB"
        FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="KpiCardStyle" TargetType="materialDesign:Card">
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
                <Setter Property="Width" Value="220"/>
            </Style>

            <conv:RelativeValueToWidthConverter x:Key="RelativeValueToWidthConverter"/>
            <conv:SparklineGeometryConverter x:Key="SparklineGeometryConverter"/>

            <Style x:Key="DashboardFilterBlockStyle" TargetType="Border">
                <Setter Property="Background" Value="#F8FAFC"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="14"/>
            </Style>

            <Style x:Key="DashboardRangeBlockStyle" TargetType="Border" BasedOn="{StaticResource DashboardFilterBlockStyle}">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedPeriod}" Value="{x:Static vm:DashboardPeriod.Range}">
                        <Setter Property="Background" Value="#EFF6FF"/>
                        <Setter Property="BorderBrush" Value="#93C5FD"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DashboardPeriodButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#334155"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="{x:Static vm:DashboardPeriod.Today}"/>
                            <Condition Binding="{Binding DataContext.SelectedPeriod, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:DashboardPeriod.Today}"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#E0F2FE"/>
                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                        <Setter Property="Foreground" Value="#0F172A"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="{x:Static vm:DashboardPeriod.Week}"/>
                            <Condition Binding="{Binding DataContext.SelectedPeriod, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:DashboardPeriod.Week}"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#E0F2FE"/>
                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                        <Setter Property="Foreground" Value="#0F172A"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="{x:Static vm:DashboardPeriod.Month}"/>
                            <Condition Binding="{Binding DataContext.SelectedPeriod, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:DashboardPeriod.Month}"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#E0F2FE"/>
                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                        <Setter Property="Foreground" Value="#0F172A"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

        <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid x:Name="DashboardTopBar" Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="24" Background="#DBEAFE" Margin="0,0,14,0">
                    <materialDesign:PackIcon Kind="ChartTimelineVariant"
                                             Width="24"
                                             Height="24"
                                             Foreground="#1D4ED8"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>

                <StackPanel>
                    <TextBlock Text="Dashboard" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CurrentRangeLabel}" Opacity="0.7" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1"
                    IsCancel="True"
                    ToolTip="Cerrar"
                    Padding="14,8"
                    Height="40"
                    BorderBrush="#CBD5E1"
                    Foreground="#334155"
                    Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Cerrar"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Filters card -->
        <materialDesign:Card x:Name="DashboardFiltersCard" Grid.Row="1" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Filtros del dashboard"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Command="{Binding ToggleFiltersExpandedCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="0,0,8,0"
                            Content="{Binding FiltersToggleLabel}"/>

                    <Border Grid.Column="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentRangeLabel}" Foreground="#475569"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="1"
                      Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource DashboardFilterBlockStyle}"
                            Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="Periodo rapido" FontWeight="SemiBold"/>
                            <TextBlock Text="Selecciona hoy, semana o mes."
                                       Margin="0,4,0,12"
                                       Opacity="0.7"/>
                            <WrapPanel>
                                <Button Width="132"
                                        Click="Today_Click"
                                        Tag="{x:Static vm:DashboardPeriod.Today}"
                                        Style="{StaticResource DashboardPeriodButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CalendarToday" Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="Hoy"/>
                                    </StackPanel>
                                </Button>

                                <Button Width="132"
                                        Click="Week_Click"
                                        Tag="{x:Static vm:DashboardPeriod.Week}"
                                        Style="{StaticResource DashboardPeriodButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CalendarWeek" Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="Semana"/>
                                    </StackPanel>
                                </Button>

                                <Button Width="132"
                                        Click="Month_Click"
                                        Tag="{x:Static vm:DashboardPeriod.Month}"
                                        Style="{StaticResource DashboardPeriodButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CalendarMonth" Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="Mes"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource DashboardRangeBlockStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Rango personalizado" FontWeight="SemiBold"/>
                                <TextBlock Text="Define un rango de fechas y aplicalo al dashboard."
                                           Margin="0,4,0,12"
                                           Opacity="0.7"/>
                            </StackPanel>

                            <WrapPanel Grid.Row="1">
                                <DatePicker SelectedDate="{Binding FromDate}"
                                            Width="150"
                                            Margin="0,0,10,10"
                                            materialDesign:HintAssist.Hint="Desde"/>

                                <DatePicker SelectedDate="{Binding ToDate}"
                                            Width="150"
                                            Margin="0,0,10,10"
                                            materialDesign:HintAssist.Hint="Hasta"/>

                                <Button Width="120"
                                        Height="40"
                                        Margin="0,0,0,10"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Command="{Binding ApplyRangeCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="Aplicar"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </materialDesign:Card>

        <!-- Content -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0.8*"/>
                <RowDefinition Height="1.3*"/>
            </Grid.RowDefinitions>

            <!-- KPIs -->
            <ScrollViewer x:Name="DashboardKpisPanel"
                          Grid.Row="0"
                          Margin="0,0,0,12"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <StackPanel Orientation="Horizontal">
                <materialDesign:Card Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="CurrencyUsd" Width="22" Height="22" Opacity="0.7"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ingresos" Opacity="0.75"/>
                            <TextBlock Text="{Binding Revenue, StringFormat={}{0:C}}"
                                       FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding RevenueDeltaText}" FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Cash" Width="22" Height="22" Opacity="0.7"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Efectivo" Opacity="0.75"/>
                            <TextBlock Text="{Binding CashRevenue, StringFormat={}{0:C}}"
                                       FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CashRevenueDeltaText}" FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="CreditCardOutline" Width="22" Height="22" Opacity="0.7"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="MercadoPago / tarjeta" Opacity="0.75"/>
                            <TextBlock Text="{Binding CardRevenue, StringFormat={}{0:C}}"
                                       FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CardRevenueDeltaText}" FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="ChartAreaspline" Width="22" Height="22" Opacity="0.7"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Margen estimado" Opacity="0.75"/>
                            <TextBlock Text="{Binding EstimatedMargin, StringFormat={}{0:C}}"
                                       FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding EstimatedMarginDeltaText}" FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>


                <materialDesign:Card Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="PackageVariant" Width="22" Height="22" Opacity="0.7"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Unidades vendidas" Opacity="0.75"/>
                            <TextBlock Text="{Binding UnitsSold}"
                                       FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UnitsSoldDeltaText}" FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="22" Height="22" Opacity="0.7"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ventas (movimientos)" Opacity="0.75"/>
                            <TextBlock Text="{Binding SalesCount}"
                                       FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SalesCountDeltaText}" FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Warehouse" Width="22" Height="22" Opacity="0.7"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Costo inmovilizado" Opacity="0.75"/>
                            <TextBlock Text="{Binding InventoryCost, StringFormat={}{0:C}}"
                                       FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Costo actual del stock" FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="PackageVariantRemove" Width="22" Height="22" Opacity="0.7"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Sin mov. en periodo" Opacity="0.75"/>
                            <TextBlock Text="{Binding ProductsWithoutMovement}"
                                       FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="SKUs activos sin movimientos" FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- Chart + Top products -->
            <Grid x:Name="DashboardHighlightsGrid" Grid.Row="1" Margin="0,0,0,12" MinHeight="180">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Padding="12" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="96"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Ventas por dia"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AverageDailyRevenueText}"
                                           Margin="0,4,0,0"
                                           Opacity="0.7"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding BestDayText}"
                                       VerticalAlignment="Center"
                                       Opacity="0.7"/>
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="0,14,0,14"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="12">
                            <Grid>
                                <Path Fill="#DBEAFE" Stretch="None">
                                    <Path.Data>
                                        <MultiBinding Converter="{StaticResource SparklineGeometryConverter}" ConverterParameter="Area">
                                            <Binding Path="DailySales"/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </Path.Data>
                                </Path>

                                <Path Stroke="#1D4ED8"
                                      StrokeThickness="3"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="None">
                                    <Path.Data>
                                        <MultiBinding Converter="{StaticResource SparklineGeometryConverter}">
                                            <Binding Path="DailySales"/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </Path.Data>
                                </Path>

                                <Border HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="#FFFFFF"
                                        BorderBrush="#DBEAFE"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="10,4"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="{Binding DailySales.Count, StringFormat={}{0} dias con ventas}"
                                               Foreground="#1D4ED8"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="#FFFFFF"
                                        BorderBrush="#DBEAFE"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="10,4">
                                    <TextBlock Text="{Binding MaxDailyRevenue, StringFormat=Pico {0:C}}"
                                               Foreground="#1E3A8A"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasDailySales, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding DailySales}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Date, StringFormat={}{0:dd/MM}}" Opacity="0.7"/>
                                                <Grid Grid.Column="1" Height="14" VerticalAlignment="Center">
                                                    <Border Background="#E5E7EB" CornerRadius="7"/>
                                                    <Border Background="#1976D2"
                                                            CornerRadius="7"
                                                            HorizontalAlignment="Left">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource RelativeValueToWidthConverter}">
                                                                <Binding Path="Revenue"/>
                                                                <Binding Path="DataContext.MaxDailyRevenue" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Revenue, StringFormat={}{0:C}}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasDailySales, Converter={StaticResource BooleanNegationConverter}}">
                                <materialDesign:PackIcon Kind="ChartLine" Width="36" Height="36" Opacity="0.35"/>
                                <TextBlock Text="No hay ventas para graficar"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,2"
                                           Opacity="0.8"/>
                                <TextBlock Text="Probá otro período o rango de fechas."
                                           Opacity="0.7"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </materialDesign:Card>

                <StackPanel Grid.Column="1">
                    <materialDesign:Card Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Top por unidades" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding TopByUnits}"
                                              Visibility="{Binding HasTopByUnits, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                    <Grid Margin="0,4,12,0" Height="8">
                                                        <Border Background="#E5E7EB" CornerRadius="4"/>
                                                        <Border Background="#43A047"
                                                                CornerRadius="4"
                                                                HorizontalAlignment="Left">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{StaticResource RelativeValueToWidthConverter}">
                                                                    <Binding Path="Units"/>
                                                                    <Binding Path="DataContext.MaxTopUnits" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                    <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                                                                </MultiBinding>
                                                            </Border.Width>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Units}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Sin datos en este período."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.7"
                                           Visibility="{Binding HasTopByUnits, Converter={StaticResource BooleanNegationConverter}}"/>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Top por ingresos" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding TopByRevenue}"
                                              Visibility="{Binding HasTopByRevenue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                    <Grid Margin="0,4,12,0" Height="8">
                                                        <Border Background="#E5E7EB" CornerRadius="4"/>
                                                        <Border Background="#FB8C00"
                                                                CornerRadius="4"
                                                                HorizontalAlignment="Left">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{StaticResource RelativeValueToWidthConverter}">
                                                                    <Binding Path="Revenue"/>
                                                                    <Binding Path="DataContext.MaxTopRevenue" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                    <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                                                                </MultiBinding>
                                                            </Border.Width>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Revenue, StringFormat={}{0:C}}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Sin datos en este período."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.7"
                                           Visibility="{Binding HasTopByRevenue, Converter={StaticResource BooleanNegationConverter}}"/>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="12" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Top por margen" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding TopByMargin}"
                                              Visibility="{Binding HasTopByMargin, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                    <Grid Margin="0,4,12,0" Height="8">
                                                        <Border Background="#E5E7EB" CornerRadius="4"/>
                                                        <Border Background="#00897B"
                                                                CornerRadius="4"
                                                                HorizontalAlignment="Left">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{StaticResource RelativeValueToWidthConverter}">
                                                                    <Binding Path="Margin"/>
                                                                    <Binding Path="DataContext.MaxTopMargin" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                    <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                                                                </MultiBinding>
                                                            </Border.Width>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Margin, StringFormat={}{0:C}}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Sin datos en este período."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.7"
                                           Visibility="{Binding HasTopByMargin, Converter={StaticResource BooleanNegationConverter}}"/>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>
                </StackPanel>
            </Grid>


            <!-- Tables -->
            <materialDesign:Card x:Name="DashboardHistoryCard" Grid.Row="2" Padding="12" MinHeight="300">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Historial de ventas"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding SalesHistory}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              RowHeight="36"
                              RowHeaderWidth="0"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha"
                                                Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                Width="170"/>
                            <DataGridTextColumn Header="SKU" Binding="{Binding SkuName}" Width="*"/>
                            <DataGridTextColumn Header="Cant." Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="P. Unit."
                                                Binding="{Binding UnitPrice, StringFormat={}{0:C}}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Total"
                                                Binding="{Binding Total, StringFormat={}{0:C}}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Nota" Binding="{Binding Note}" Width="220"/>
                            <DataGridTemplateColumn Header="Acciones" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Borrar"
                                                Padding="12,4"
                                                MinWidth="80"
                                                MinHeight="26"
                                                VerticalAlignment="Center"
                                                Background="#D32F2F"
                                                Foreground="White"
                                                BorderBrush="#B71C1C"
                                                Command="{Binding DataContext.DeleteSaleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

        </Grid>
    </Grid>
</Window>
