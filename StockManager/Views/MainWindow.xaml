<Window x:Class="StockManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StockManager.Controls"
        xmlns:local="clr-namespace:StockManager.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Stock Manager"
        Height="540" Width="1040"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F4F7FB"
        FontSize="13">

    <Window.Resources>
        <Style x:Key="SurfaceCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SummaryTileStyle" TargetType="materialDesign:Card">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="StockGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="SortDirection" Value="Ascending">
                    <Setter Property="Foreground" Value="#1565C0"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <Trigger Property="SortDirection" Value="Descending">
                    <Setter Property="Foreground" Value="#1565C0"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StockGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
                <DataTrigger Binding="{Binding DataContext.IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Padding" Value="10,4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StockGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FCFDFE"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FBFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuickFilterButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="BorderBrush" Value="#1565C0"/>
                    <Setter Property="Foreground" Value="#1565C0"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Atajos -->
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.RefreshCmd}" />
        <KeyBinding Key="Delete" Command="{x:Static local:MainWindow.DeleteSkuCmd}" />
        <KeyBinding Modifiers="Control" Key="N" Command="{x:Static local:MainWindow.NewSkuCmd}" />
        <KeyBinding Modifiers="Control" Key="M" Command="{x:Static local:MainWindow.MovementCmd}" />
        <KeyBinding Modifiers="Control" Key="F" Command="{x:Static local:MainWindow.FocusSearchCmd}" />
        <KeyBinding Modifiers="Control" Key="E" Command="{x:Static local:MainWindow.EditSkuCmd}" />
        <KeyBinding Modifiers="Control" Key="D" Command="{x:Static local:MainWindow.DuplicateSkuCmd}" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.NewSkuCmd}" Executed="NewSku_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.MovementCmd}" Executed="Movement_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.RefreshCmd}" Executed="Refresh_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.DeleteSkuCmd}" Executed="DeleteSku_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.EditSkuCmd}" Executed="EditSku_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.FocusSearchCmd}" Executed="FocusSearch_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.DuplicateSkuCmd}" Executed="DuplicateSku_Executed"/>
    </Window.CommandBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid x:Name="TopBarPanel" Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="52" Height="52" CornerRadius="26" Background="#DBEAFE" Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#1D4ED8"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Planeta Celular" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ItemsSummaryText}" Opacity="0.7" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <WrapPanel x:Name="TotalsCard" Margin="0,12,0,0">
                    <Border Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="10,4"
                            Margin="0,0,8,8">
                        <TextBlock Text="{Binding CriticalItemsBadgeText}" Foreground="#B45309" FontWeight="SemiBold"/>
                    </Border>

                    <Border Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="10,4"
                            Margin="0,0,8,8">
                        <TextBlock Text="{Binding TotalCost, StringFormat=Costo {0:C}}" Foreground="#166534" FontWeight="SemiBold"/>
                    </Border>

                    <Border Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="10,4"
                            Margin="0,0,8,8">
                        <TextBlock Text="{Binding TotalPrice, StringFormat=Precio {0:C}}" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                    </Border>

                    <Border Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="10,4"
                            Margin="0,0,8,8">
                        <TextBlock Text="{Binding TotalMargin, StringFormat=Margen {0:C}}" Foreground="#7C3AED" FontWeight="SemiBold"/>
                    </Border>
                </WrapPanel>
            </StackPanel>

            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Click="Dashboard_Click"
                        ToolTip="Dashboard"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ChartTimelineVariant" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Dashboard"/>
                    </StackPanel>
                </Button>

                <Button Click="NewSku_Click"
                        ToolTip="Nuevo SKU (Ctrl+N)"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Nuevo item"/>
                    </StackPanel>
                </Button>

                <Button Click="EditSku_Click"
                        ToolTip="Editar SKU (Ctrl+E)"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Editar"/>
                    </StackPanel>
                </Button>

                <Button Click="DuplicateSku_Click"
                        ToolTip="Duplicar SKU (Ctrl+D)"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Duplicar"/>
                    </StackPanel>
                </Button>

                <Button Click="BulkPriceUpdate_Click"
                        ToolTip="Actualizar precios por tipo o porcentaje global"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TagMultiple" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Actualizar precios"/>
                    </StackPanel>
                </Button>

                <Button Click="DeleteSku_Click"
                        ToolTip="Eliminar SKU seleccionado (Supr)"
                        Margin="0,0,0,8">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Opacity" Value="0.6"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DeleteOutline"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,8,0"
                                                 Foreground="#C62828"/>
                        <TextBlock Text="Eliminar item" Foreground="#C62828"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>

        <!-- Filters card -->
        <materialDesign:Card x:Name="FiltersCard" Grid.Row="1" Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Filtros y busqueda" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Command="{Binding ToggleFiltersExpandedCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="0,0,8,0"
                            Content="{Binding FiltersToggleLabel}"/>

                    <Border Grid.Column="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding FilterSummaryText}" Foreground="#475569"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,0,0,12"
                      Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="14"
                            Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Filtros base" FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,12,0,0">
                                <ComboBox Width="190" Margin="0,0,12,10"
                                          ItemsSource="{Binding CategoryOptions}"
                                          SelectedItem="{Binding SelectedCategoryOption}"
                                          DisplayMemberPath="Display"
                                          materialDesign:HintAssist.Hint="Categoria"/>

                                <ComboBox Width="150" Margin="0,0,12,10"
                                          ItemsSource="{Binding ActiveOptions}"
                                          SelectedItem="{Binding SelectedActive}"
                                          materialDesign:HintAssist.Hint="Estado"/>

                                <CheckBox Content="Stock bajo"
                                          Margin="0,0,10,10"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding StockLowOnly}"/>

                                <TextBox Width="92"
                                         Margin="0,0,0,10"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding StockLowThreshold, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="&lt;= umbral"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="Busqueda y vista" FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,12,0,0">
                                <TextBox x:Name="SearchTextBox"
                                         Width="340"
                                         Margin="0,0,10,10"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Buscar por nombre, tipo, precio, costo o stock"/>

                                <Button Width="110"
                                        Command="{Binding SearchCommand}"
                                        Margin="0,0,10,10"
                                        Style="{StaticResource MaterialDesignRaisedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="Buscar"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ToggleGridDensityCommand}"
                                        Margin="0,0,0,10"
                                        Style="{StaticResource MaterialDesignOutlinedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ViewCompactOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding GridDensityLabel}"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <DockPanel Grid.Row="2"
                           LastChildFill="True"
                           Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel DockPanel.Dock="Left" Margin="0,0,12,0">
                        <TextBlock Text="Accesos rapidos" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Style="{StaticResource QuickFilterButtonStyle}"
                                    Tag="{Binding QuickActiveOnly}"
                                    Command="{Binding ToggleQuickFilterCommand}"
                                    CommandParameter="Active"
                                    Content="Solo activos"/>

                            <Button Style="{StaticResource QuickFilterButtonStyle}"
                                    Tag="{Binding QuickOutOfStockOnly}"
                                    Command="{Binding ToggleQuickFilterCommand}"
                                    CommandParameter="OutOfStock"
                                    Content="Sin stock"/>

                            <Button Style="{StaticResource QuickFilterButtonStyle}"
                                    Tag="{Binding QuickCasesOnly}"
                                    Command="{Binding ToggleQuickFilterCommand}"
                                    CommandParameter="Cases"
                                    Content="Fundas"/>

                            <Button Style="{StaticResource QuickFilterButtonStyle}"
                                    Tag="{Binding QuickProtectorsOnly}"
                                    Command="{Binding ToggleQuickFilterCommand}"
                                    CommandParameter="Protectors"
                                    Content="Templados"/>

                            <Button Style="{StaticResource QuickFilterButtonStyle}"
                                    Tag="{Binding QuickSoldTodayOnly}"
                                    Command="{Binding ToggleQuickFilterCommand}"
                                    CommandParameter="SoldToday"
                                    Content="Hoy vendi"/>
                        </WrapPanel>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding ToggleQuickFilterCommand}"
                            CommandParameter="Clear"
                            Content="Limpiar rapidos"/>
                </DockPanel>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card x:Name="CriticalCard" Grid.Row="2"
                             Padding="12"
                             Margin="0,0,0,12"
                             Background="#FFF8E1"
                             Visibility="{Binding HasCriticalItems, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,10" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertOutline" Width="18" Height="18" Foreground="#EF6C00"/>
                            <TextBlock Text="Reposicion sugerida" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CriticalItemsSummary}" Margin="26,4,0,0" Opacity="0.75"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Command="{Binding ToggleCriticalItemsExpandedCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Content="{Binding CriticalItemsToggleLabel}"/>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding CriticalItems}"
                              Visibility="{Binding IsCriticalItemsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,0,10,10" Padding="10" Width="250">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,4,0,8"
                                               Text="{Binding Stock, StringFormat=Stock actual: {0}}"
                                               Opacity="0.75"/>
                                    <Button Command="{Binding DataContext.ReplenishCriticalItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CartPlus" Width="18" Height="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="Reponer +1"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </materialDesign:Card>

        <!-- Content -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Grid -->
            <materialDesign:Card x:Name="StockGridCard" Grid.Column="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="16,14,16,12" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Stock actual" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ItemsSummaryText}" Opacity="0.7" Margin="0,4,0,0"/>
                        </StackPanel>

                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    Padding="10,4"
                                    Margin="0,0,8,0">
                                <TextBlock Text="{Binding GridDensityLabel}" Foreground="#475569"/>
                            </Border>

                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    Padding="10,4">
                                <TextBlock Text="Usa los encabezados para ordenar" Foreground="#475569"/>
                            </Border>
                        </WrapPanel>
                    </DockPanel>

                    <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                        <Grid>
                            <DataGrid x:Name="ItemsGrid"
                                      ItemsSource="{Binding ItemsView}"
                                      SelectedItem="{Binding SelectedItem}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      RowHeight="{Binding GridRowHeight}"
                                      FontSize="{Binding GridFontSize}"
                                      ColumnHeaderHeight="42"
                                      AlternationCount="2"
                                      Sorting="ItemsGrid_Sorting"
                                      ColumnHeaderStyle="{StaticResource StockGridColumnHeaderStyle}"
                                      CellStyle="{StaticResource StockGridCellStyle}"
                                      RowStyle="{StaticResource StockGridRowStyle}"
                                      Margin="0">

                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Producto"
                                                            SortMemberPath="Name"
                                                            Width="3.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <controls:HighlightTextBlock SourceText="{Binding Name}"
                                                                                 HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 HighlightBackground="#FFF0A8"
                                                                                 FontWeight="SemiBold"
                                                                                 TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding CategoryLabel}"
                                                               Margin="0,2,0,0"
                                                               Opacity="0.65"
                                                               FontSize="11"
                                                               Visibility="{Binding DataContext.IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanNegationConverter}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Tipo"
                                                            SortMemberPath="Category"
                                                            Width="1.7*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding VariantLabel}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Opacity="0.9"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Estado"
                                                            SortMemberPath="Active"
                                                            Width="0.95*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,3"
                                                        CornerRadius="10"
                                                        HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E8F5E9"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Active}" Value="False">
                                                                    <Setter Property="Background" Value="#ECEFF1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusLabel}"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#1B5E20"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Active}" Value="False">
                                                                        <Setter Property="Foreground" Value="#546E7A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Stock"
                                                            Width="0.9*"
                                                            SortMemberPath="Stock"
                                                            CanUserSort="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Stock, Converter={StaticResource StockLevelToBrushConverter}}"
                                                        Padding="6,2"
                                                        CornerRadius="10"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Stock}"
                                                               Foreground="{Binding Stock, Converter={StaticResource StockLevelToBrushConverter}, ConverterParameter=Foreground}"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Precio"
                                                            SortMemberPath="Price"
                                                            Width="1.15*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Price, StringFormat={}{0:C}}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Cost, StringFormat=Costo {0:C}}"
                                                               Margin="0,2,0,0"
                                                               Opacity="0.65"
                                                               FontSize="11"
                                                               Visibility="{Binding DataContext.IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanNegationConverter}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty state -->
                            <Grid Background="#00FFFFFF"
                                  Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="72" Height="72" CornerRadius="36" Background="#EEF2FF">
                                        <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                                 Width="34"
                                                                 Height="34"
                                                                 Foreground="#4F46E5"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="No hay items para mostrar"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Margin="0,14,0,4"
                                               Opacity="0.82"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Crea un nuevo item o ajusta los filtros para ver resultados."
                                               Opacity="0.72"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="360"/>
                                </StackPanel>
                            </Grid>

                            <!-- Loading overlay -->
                            <Grid Background="#55FFFFFF"
                                  Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <materialDesign:Card Padding="18"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ProgressBar Width="140" Height="6" IsIndeterminate="True"/>
                                        <TextBlock Text="  Cargando..." VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </materialDesign:Card>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </materialDesign:Card>

            <!-- Detail -->
            <materialDesign:Card x:Name="DetailPanelCard" Grid.Column="1" Margin="12,0,0,0" Padding="14" Background="#FBFCFE">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasSelectedItem, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" CornerRadius="18" Padding="16" Margin="0,0,0,12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0F172A" Offset="0"/>
                                        <GradientStop Color="#1D4ED8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>

                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Width="250">
                                            <TextBlock Text="Detalle del item"
                                                       Foreground="#BFDBFE"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DetailTitle}"
                                                       Foreground="White"
                                                       FontSize="19"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,4"/>
                                            <TextBlock Text="{Binding SelectedItem.VariantLabel, TargetNullValue=Selecciona un item}"
                                                       Foreground="#DBEAFE"
                                                       TextWrapping="Wrap"
                                                       Opacity="0.9"/>
                                        </StackPanel>

                                        <Border DockPanel.Dock="Right"
                                                Width="44"
                                                Height="44"
                                                CornerRadius="22"
                                                Background="#1E3A8A">
                                            <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                                     Width="22"
                                                                     Height="22"
                                                                     Foreground="White"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"/>
                                        </Border>
                                    </DockPanel>

                                    <WrapPanel Margin="0,14,0,0">
                                        <Border Padding="10,4" Margin="0,0,8,8" CornerRadius="999" Background="#1E40AF">
                                            <TextBlock Text="{Binding DetailCategory}" Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Padding="10,4" Margin="0,0,8,8" CornerRadius="999">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedItem.Active}" Value="False">
                                                            <Setter Property="Background" Value="#E5E7EB"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DetailActive}" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#166534"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedItem.Active}" Value="False">
                                                                <Setter Property="Foreground" Value="#475569"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Border Padding="10,4" Margin="0,0,8,8" CornerRadius="999" Background="#DBEAFE">
                                            <TextBlock Text="{Binding DetailStock, StringFormat=Stock {0}}" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                <Border Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Margin="0,0,12,10">
                                            <TextBlock Text="Estado" Opacity="0.65" FontSize="11"/>
                                            <TextBlock Text="{Binding DetailActive}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,0,10">
                                            <TextBlock Text="Categoria" Opacity="0.65" FontSize="11"/>
                                            <TextBlock Text="{Binding DetailCategory}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Margin="0,0,12,0">
                                            <TextBlock Text="Stock total" Opacity="0.65" FontSize="11"/>
                                            <TextBlock Text="{Binding DetailStock}" FontWeight="SemiBold" FontSize="16" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Text="Margen unitario" Opacity="0.65" FontSize="11"/>
                                            <TextBlock Text="{Binding DetailMargin, StringFormat={}{0:C}}" FontWeight="SemiBold" FontSize="16" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Margin="0,0,6,0"
                                            Background="#F0FDF4"
                                            CornerRadius="16"
                                            Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Precio" Foreground="#15803D" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DetailPrice, StringFormat={}{0:C}}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Background="#FFF7ED"
                                            CornerRadius="16"
                                            Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Costo" Foreground="#C2410C" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DetailCost, StringFormat={}{0:C}}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14"
                                        Visibility="{Binding IsGenderedDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="GenderFemale" Width="16" Height="16" Foreground="#EC4899"/>
                                                <TextBlock Text="Stock mujer" Margin="6,0,0,0" Opacity="0.75"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DetailCaseStockWomen}" FontWeight="SemiBold" FontSize="17" Margin="0,6,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="GenderMale" Width="16" Height="16" Foreground="#2563EB"/>
                                                <TextBlock Text="Stock hombre" Margin="6,0,0,0" Opacity="0.75"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DetailCaseStockMen}" FontWeight="SemiBold" FontSize="17" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#2563EB" CornerRadius="2"/>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Ultimo movimiento" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding LastMovementText}"
                                                   Opacity="0.88"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="3"
                                    Background="#FAFAFA"
                                    BorderBrush="#ECEFF1"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Acciones rapidas" FontWeight="SemiBold"/>
                                    <TextBlock Text="Registra compras, ventas o consulta el historial del item."
                                               Opacity="0.7"
                                               Margin="0,4,0,12"/>

                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <Button Margin="0,0,10,0"
                                                MinWidth="120"
                                                Command="{Binding QuickPurchaseCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CartPlus" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="+1 compra"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Margin="0,0,0,0"
                                                MinWidth="120"
                                                Command="{Binding QuickSaleCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CartMinus" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="-1 venta"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>

                                    <Button Margin="0,0,0,8"
                                            Click="RegisterMovement_Click"
                                            Style="{StaticResource MaterialDesignRaisedButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="SwapVertical" Width="18" Height="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="Registrar movimiento..."/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="ViewHistory_Click"
                                            Style="{StaticResource MaterialDesignOutlinedButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="History" Width="18" Height="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="Ver historial..."/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <Grid Background="#FBFCFE"
                          Visibility="{Binding HasSelectedItem, Converter={StaticResource BooleanNegationConverter}}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="260">
                            <Border Width="76" Height="76" CornerRadius="38" Background="#DBEAFE">
                                <materialDesign:PackIcon Kind="CursorDefaultClickOutline"
                                                         Width="34"
                                                         Height="34"
                                                         Foreground="#1D4ED8"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Seleccioná un item"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,16,0,6"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Aqui se muestran precio, costo, stock, ultimo movimiento y acciones rapidas."
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Opacity="0.72"/>

                            <Border Margin="0,18,0,10"
                                    Padding="12"
                                    Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                <StackPanel>
                                    <TextBlock Text="Ayuda" FontWeight="SemiBold"/>
                                    <TextBlock Text="Puedes ordenar la lista desde los encabezados y buscar sin acentos."
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Opacity="0.72"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Atajos disponibles: Ctrl+F buscar, Ctrl+E editar, Ctrl+D duplicar."
                                       Opacity="0.68"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- Overlay detalle -->
                    <Grid Background="#55FFFFFF"
                          Visibility="{Binding IsDetailLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Margin="-14,-14,-14,-14">
                        <materialDesign:Card Padding="14"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ProgressBar Width="120" Height="6" IsIndeterminate="True"/>
                                <TextBlock Text="  Cargando detalle..." VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </Grid>
            </materialDesign:Card>

        </Grid>

        <materialDesign:Snackbar Grid.RowSpan="5"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,24,24"
                                 MessageQueue="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SnackbarMessageQueue}"/>
    </Grid>
</Window>
