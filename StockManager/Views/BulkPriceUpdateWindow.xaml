<Window x:Class="StockManager.Views.BulkPriceUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualizar precios"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="480">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Actualizar precios"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14"
                Margin="0,0,0,12"
                Background="#FAFCFF">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Actualizar por tipo"
                           FontSize="15"
                           FontWeight="SemiBold"/>

                <Grid Grid.Row="1" Margin="0,12,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Categoria"
                               VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="1"
                              Width="230"
                              ItemsSource="{Binding CategoryOptions}"
                              DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedCategoryOption, Mode=TwoWay}"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,10"
                      Visibility="{Binding IsCaseCategory, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Tipo de funda"
                               VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="1"
                              Width="230"
                              ItemsSource="{Binding CaseTypeOptions}"
                              SelectedItem="{Binding SelectedCaseType, Mode=TwoWay}"/>
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,10"
                      Visibility="{Binding IsProtectorCategory, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Tipo templado"
                               VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="1"
                              Width="230"
                              ItemsSource="{Binding ProtectorTypeOptions}"
                              SelectedItem="{Binding SelectedProtectorType, Mode=TwoWay}"/>
                </Grid>

                <Grid Grid.Row="4" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Precio"
                               VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Width="140"
                             VerticalContentAlignment="Center"
                             Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Grid Grid.Row="5" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Costo"
                               VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Width="140"
                             VerticalContentAlignment="Center"
                             Text="{Binding CostText, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <DockPanel Grid.Row="6" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Width="280"
                               Text="Actualiza el precio y/o costo de todos los items del tipo seleccionado."
                               TextWrapping="Wrap"
                               Foreground="#666666"/>

                    <Button DockPanel.Dock="Right"
                            Width="150"
                            Click="ApplyByType_Click"
                            Content="Actualizar por tipo"/>
                </DockPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14"
                Margin="0,0,0,12"
                Background="#FFFDF7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Porcentaje global"
                           FontSize="15"
                           FontWeight="SemiBold"/>

                <Grid Grid.Row="1" Margin="0,12,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Porcentaje"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="140"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding GlobalPercentageText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="%"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2">
                    <CheckBox Content="Redondear al 100 mas cercano"
                              IsChecked="{Binding RoundGlobalPriceToHundred}"
                              Margin="0,0,0,10"/>

                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Width="280"
                                   Text="Ejemplos: 10 sube 10% todos los precios. -5 baja 5%. Si el redondeo esta activo, el precio final queda en multiplos de 100."
                                   TextWrapping="Wrap"
                                   Foreground="#666666"/>

                        <Button DockPanel.Dock="Right"
                                Width="190"
                                Click="ApplyGlobalPercentage_Click"
                                Content="Aplicar porcentaje global"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="DarkRed"
                   TextWrapping="Wrap"
                   Width="420"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Cancelar"
                    Width="90"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
